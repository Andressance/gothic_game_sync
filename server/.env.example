# Local server configuration. Render should use dashboard environment secrets.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=gothic-saves

# API key required in the X-API-Key header (all routes except /health).
# Leave empty to disable authentication (development only).
GOTHICSAVE_API_TOKEN=replace-with-long-random-token

# Maximum size of one .gss package in MiB (default 64).
# GOTHICSAVE_MAX_MB=64

# Optional only when Supabase variables are absent:
# GOTHICSAVE_STORAGE=storage
